<IfModule mod_rewrite.c>
    RewriteEngine On

    # Block direct browser access to protected directories
    RewriteRule ^(app|bootstrap|config|database|resources|routes|storage|cron)($|/) - [F,L,NC]

    # Route requests to public directory
    RewriteRule ^$ public/ [L]
    RewriteRule (.*) public/$1 [L]
</IfModule>

# Protect sensitive environment and system files
<FilesMatch "^\.env|\.git|composer\.|package\.|tsconfig|webpack|vite|schema|seed">
    Order allow,deny
    Deny from all
</FilesMatch>

Options -Indexes
